<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
	<PlatformTarget>x64</PlatformTarget>
	<!-- <WarningLevel>0</WarningLevel> -->

	<NoWarn>
		$(NoWarn);
		CS8602; <!-- Dereference of a possibly null reference -->
		CS0162; <!-- Unreachable code detected -->
		CS8981; <!-- Type name contains only lowercase ASCII characters -->
		CS8622; <!-- Nullability of reference types in type of parameter doesn't match target delegate -->
		CS8618; <!-- Non-nullable property or field must contain a non-null value when exiting constructor -->
		CS8625; <!-- Cannot convert null literal to non-nullable reference type -->
		CS8603; <!-- Possible null reference return -->
		CS8604; <!-- Possible null reference argument for a non-nullable parameter -->
		CS0168; <!-- Variable is declared but never used -->
		CS8600; <!-- Converting null literal or possible null value to non-nullable type -->
		CS0219; <!-- Variable is assigned but its value is never used -->
		CS0169; <!-- Field is never used -->
		CS0108; <!-- Member hides an inherited member; missing 'new' keyword -->
		CS0649; <!-- Field is never assigned to, and will always have its default value -->
		CS8601; <!-- Possible null reference assignment -->
		CS0414  <!-- Field is assigned but its value is never used -->
	</NoWarn>


	
  </PropertyGroup>
<ItemGroup>
  <EmbeddedResource Include="Resources\**" />
</ItemGroup>

</Project>

